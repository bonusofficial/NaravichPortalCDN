NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ORIGINS=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=naravich_cdn
DB_LOGGING=false

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_SECONDS=28800
API_KEY_PEPPER=replace-with-another-long-random-secret

STORAGE_ROOT=./storage
TEMP_ROOT=./storage/.tmp
PUBLIC_ASSET_BASE_URL=http://localhost:3000/files
MAX_INPUT_BYTES=25000000
MAX_OUTPUT_BYTES=5000000
MAX_INPUT_PIXELS=40000000
MAX_IMAGE_DIMENSION=4096
STARTING_WEBP_QUALITY=82
PROCESSING_CONCURRENCY=2
DISK_WARNING_PERCENT=70
DISK_STOP_UPLOAD_PERCENT=88

SEED_ADMIN_NAME=Local Administrator
SEED_ADMIN_EMAIL=admin@naravich.local
SEED_ADMIN_PASSWORD=ChangeMe123!
