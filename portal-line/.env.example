# ── Server ─────────────────────────────────────────────
# ใช้ 127.0.0.1 เมื่อวางหลัง nginx, ใช้ 0.0.0.0 ถ้าต้องให้เครื่องอื่นยิงเข้ามาตรง ๆ
HOST=127.0.0.1
PORT=3100
# URL ที่ตั้งใน LINE Developers Console = https://<โดเมน><WEBHOOK_PATH>
WEBHOOK_PATH=/webhook/line

# ── LINE ───────────────────────────────────────────────
# Channel secret จาก LINE Developers Console > Basic settings (ใช้ตรวจ x-line-signature)
LINE_CHANNEL_SECRET=replace-with-line-channel-secret

# ── ปลายทาง (เพิ่มได้เรื่อย ๆ: DEST_4_..., DEST_5_...) ────
# DEST_n_URL      (จำเป็น) URL ที่จะ forward ไป
# DEST_n_NAME     ชื่อที่แสดงใน log (ไม่ใส่ = destn)
# DEST_n_ENABLED  true/false เปิด-ปิดปลายทาง (ไม่ใส่ = true) แก้แล้ว restart
# DEST_n_HEADERS  header เพิ่มเติมแบบ JSON เช่น {"Authorization":"Bearer xxx"}
# DEST_n_TIMEOUT_MS  timeout เฉพาะปลายทางนี้ (ไม่ใส่ = FORWARD_TIMEOUT_MS)

DEST_1_NAME=website1
DEST_1_URL=https://website1.example.com/api/line/webhook
DEST_1_ENABLED=true
DEST_1_HEADERS=

DEST_2_NAME=website2
DEST_2_URL=https://website2.example.com/api/line/webhook
DEST_2_ENABLED=true
DEST_2_HEADERS=

DEST_3_NAME=website3
DEST_3_URL=https://website3.example.com/api/line/webhook
DEST_3_ENABLED=true
DEST_3_HEADERS=

# ── Forward / Retry ────────────────────────────────────
# timeout ต่อการยิง 1 ครั้ง (ms)
FORWARD_TIMEOUT_MS=5000
# จำนวนครั้งที่ลองใหม่เมื่อ error/timeout/5xx/429 (3 = ยิงสูงสุด 4 ครั้ง)
FORWARD_MAX_RETRIES=3
# รอก่อน retry: 1s, 2s, 4s, ... (เพิ่มเท่าตัวทุกครั้ง)
FORWARD_RETRY_BASE_MS=1000

# ── กันยิงซ้ำ ──────────────────────────────────────────
# จำ webhookEventId ไว้กี่วินาที event ที่ซ้ำหรือเก่ากว่านี้จะไม่ถูกส่งต่อ (86400 = 1 วัน)
DEDUP_TTL_SECONDS=86400

# ── Log ───────────────────────────────────────────────
LOG_DIR=./logs
LOG_RETENTION_DAYS=14
# true = เก็บ payload เต็มลง log (มีข้อความ/userId ของลูกค้า เปิดเฉพาะตอน debug)
LOG_PAYLOAD=false

# ── Admin ──────────────────────────────────────────────
# ใช้ดู /admin/status และ /admin/logs (เว้นว่าง = ปิด admin endpoint)
ADMIN_TOKEN=
